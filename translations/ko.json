{
  "8ecbcf89241b931eb79669a95fc2e24a22b0c15df6561db208a1f58dd395cee4": "...여긴 어디지?",
  "dfe18b2a55d4ae6730363eacc19bcb0f65072fe511f6accd32c844311bb5d4d5": "드디어 왔네.",
  "574ced7d8c0b59a2ab6c55fabd0098171cf3320dfcbc66bf68b7fd3afc6c707c": "우, 우리 아는 사이야?",
  "8a29c1a12bd4b799a78604f7f76bd0b4df37927a47a3a1881478c469a628c881": "안타깝지만 이제는 아니야.",
  "c3dcb596fe09e41e215fbf7f86cfb2a58e1ce8d4cae1c1843973c97008267858": "잠깐... 넌 누구야?",
  "62a71c04aaea98c698044f46c1fcc94092b849c20370593af1fec68b9252b413": "아주 오랫동안 널 기다렸어.",
  "33bc32c2fee0cb411efbfdd931308caaad5782a5a1fc10e9584f523a8de8fbea": "왜? 무슨 일이야?",
  "5d7bfabf849d8b7f6bc9a63c415a73ff653152678448ba3286ae5f3ab1a85c1f": "이번 토요일에 옥상으로 와 줘.",
  "ecc36df7ff2c2b34bbb2656588dd80fea0a6206896ce9be7c1444d1ac5392c59": "응? 뭐라고? 잠깐...",
  "34621f0d50c83c4de241348b5c775b75e0ba31c149df2d2b6ac0decc370fccfb": "기다려!",
  "b27755d18817337f8e6efe3d60d98f5533c18f570c6206689719e22211eef624": "도와줘, 제이콥...",
  "e84e40db27356f67f9abfcf808d4b244f96b4eaffb593564208f1b2db1e99d30": "...으으. 무슨 꿈이었지?",
  "1bc14074791673eabbe7eed00266d53b318ce90f7631d2e0b8bef0fa0bc81022": "TV를 보기 전에 먼저 씻어야겠어.",
  "8466db0ed4f98569d9899f869d40b3c16825e90a99e8ee8ce01329e436e6b235": "뭐야...?",
  "a1b53e19fd034f7fe58673fe5980544a9f2d398f6b125d3e979250a287279953": "진짜야? 신호가 끊겼잖아?",
  "e24c37e749a8491fffcd850335bb5c66c8c4f650b46bc97a7a6e99d159b7503f": "아... 머리 아파...",
  "6d9adf76607c5ac434b28b82a8958a862a4298fb2913bd8d790632c9709ee930": "여긴 어디지...?",
  "003a19f56d9437046805c8dac4d4fa9b5112d410310426308d95f833787efdde": "왜 예전에 다니던 학교에 와 있는 거지?",
  "801b25374f2cb0c567a67cca9ff20b844668c1cc74c0d8ef0fd711d12ceebcf6": "꿈인가...?",
  "9e1dc0bbc5d05d90fba3095aaf9022ad4fea7de0d50336bee43f09126689ccdd": "아... 젠장! 아으... 아파!",
  "3f85e76a501f359bc3e9a81efeba179ca491025b59c7dc7a362c3f525e2ac4df": "야... 괜찮아?!",
  "ea99d0af947e19de1fe7fc2f292aaf993c7e90f81b374e89d7fdf05b8bc2c723": "쉿... 넌 아무것도 못 본 거야! 알았지!",
  "ee70aaced1c6a99ea75fc48a214f40ca747524f5f02d4b125aa1da2476e21c73": "어떻게 못 봐? 바로 눈앞에서 넘어졌는데.",
  "c6a3d04d8825d62d566a882a66b159d0163e04fb80df5a7a3b628d861ca1dc14": "실례지만, 넘어진 거 아니거든. 전략적으로 착지한 거야.",
  "85391e6ec80ab0e8f1f9daf3b99f4c69a8c4255d9aa49373e2e517c2c15f308f": "아, 그래? 그 '전략적 착지' 꽤 아파 보이던데.",
  "515c0fa4aa5d70efc8a2623fb6e44d4c454c5185b9f60b939687004349be626d": "그나저나, 정말 일어설 수 있겠어?",
  "fa114786e0f0f963a84e2d4074c7d7f9e7d39dcc41f6b776e5e5ca73da57b314": "당연하지... 그럼!",
  "068708519a52bce26d1c6291e9dc135258dd1894f0f9cadf53291c18d13b0a2c": "잠깐... 너 제이콥 맞지?",
  "d7973891f14567d43ae3d8bc5763543e19bf0b23a1673e6fc08856e59d46858d": "내 이름을 어떻게 알아?",
  "5d0dc9d3d787c6446056d79c06f313e6672bbba98abbc5b85c6fc250c696e0c1": "와, 너무하네. 나 네 친구잖아!",
  "dfc00f2339506f37e44d492fe4054d4e44c70a9b486cb62eb3bfb9d1430fe562": "나 체사야.",
  "018475affb777674fbd11b661981f07f45fa124f0acc5e23f5a711597542e7e8": "우리 예전엔 정말 친했잖아.",
  "d7e2a62b4e66c7cb59bc301ffb48ad157d5ca735927797fe60d8017785cae6fe": "생각해 보니까 진짜 오랜만이다, 제이콥. 헤헤.",
  "507ff2bf0f31de6541b84b480bb14020610108290558175ec53d7ca24d584551": "왜 전학 간 거야?",
  "43d2acf015748c4fc30970fa5fa72ce4d55a704c80db3a4f9c4fef0c499dcca5": "이젠 나랑 단짝 하기 싫어진 거야?",
  "10f7b0c383f81ffd4770b6bab0a968b474eb1820642674f47a18c239d60a12cc": "미안... 기억이 안 나.",
  "e0c046d892a7f438e236a9a05da9255749bb6b8862a6f3a7e71f61813803bea0": "아무튼, 난 여기서 뭘 좀 찾고 있어.",
  "d498e8997de18ba123ccc36034ae1106c895e19bfc30b8de447ae98794739972": "넌? 여긴 왜 왔어?",
  "2b01b074dce5ffc0bcb811735c0950dcecfeb6c662d57b6eec4a48faecadf99e": "나도 그게 알고 싶어... 내가 왜 여기 있는지.",
  "4feb2e87ef2b8afb8d5f0dea965745d2dca94109d13166f0de2db4bc92afe432": "그럼 일단 안으로 들어갈까? :)",
  "78839be6f829be248032c774097139ec40bcc216b258e223619898a53c746db3": "그러니까아... 정말 오랜만이야, 제이콥. 헤헤헤.",
  "57168c2c11c8b23daabd519a7e9834adf70d1d50bc9c29774a43042a076b065f": "너 왜 그래?",
  "40a62cc27e0735090f344841af3bb256c2811ddb4f7536f4c3ea235633eb3076": "무슨 뜻이야?",
  "cbab80fd8f5bcd4ab1933467a4f3053197e9b7dd96455bc8f4404249f948e6bb": "너 좀... 이상한 거 알아?",
  "5fdee7e913526be19e43463726020b09da8faff3975304835e7c508a8310a2fe": "난 멀쩡하거든.",
  "616add419fe011047e2ce3f4a76982156abd789450b792935c9058af0da28bd5": "제이콥, 내가 학교 구경시켜 줄까? 헤헤.",
  "98a15a6d08b18569793db25f58385544229773e0660f981de56e1af9f0483b37": "말 없으면 좋다는 뜻이지? 자, 가자!",
  "fab08326a871a84b7c0ce3cc4a597ab2e1424df374393f535c92738a886ed6a3": "여기가 보건실이야. 헤헤.",
  "e065336491b54893aca77a148a323a604909d7ab56dee3bd2bbf9f17c91a35a6": "넌 맨날 여기 와 있었지...",
  "2bb594d574404fe554cf27d27ca8845a49a08c874cbf1e1064e1153691dda223": "다칠 때마다 말이야.",
  "116ad5d48447519a9a5f829692a509dc11e05778bdba1080341f14a3600156cb": "그래서 내가 항상 들러서 널 보곤 했잖아, 바보야.",
  "de1adc0d30a4ce5c0c0c196b66675d0d20b5f2809323a6319c7f9299a0464735": "너 정말 말 많다, 체사. 하하.",
  "a1dfd0250988c8894814eeaecfcffa80d20a326315d1e4f1fe8c59bcf743fe6e": "오늘은 내가 네 안내원이잖아. 헤헤.",
  "cdb816a397fe0c7c0b19acbddbfd5e2d6eaa0aede6a85a6a060ff2da5f282813": "가자, 제이콥.",
  "fc5463b68a6c041a12822c9f1f7b3c928f17a8a3c6be287ce509b8a099d95fba": "체사?",
  "b026444be73a3b1dc450efb7b5cf50fd7ebfbc15783211fa33f2c4fa49dcc644": "와아.",
  "7da7b8e9c2e342b459c962d0132795e005f9e25796bf772a1c05cdd2a8da3895": "가자, 제이콥.",
  "1b5214acc57416eac3700c2a7056cb4c2f4690a18af5742ab32e36623aa725e6": "참, 여기는 교무실이야.",
  "e67f92768b3ca1a24483dee6a05249056cd8d2ecb4e56d72d12ba919399b570b": "난 여기 별로 안 좋아해.",
  "452e28e09b06b6e83aefd868d77737d2f713f3ce39ae13a3529afc49014f7444": "성적 매기는 악마들이 모여 있던 곳이지.",
  "df2c3978aaf612dbc912f8056b61a552141aa33285c0a1a30c3b8b6b901bca38": "아무리 잘해도 무슨 핑계를 대서든 낙제를 주잖아.",
  "159372b94048026f0d0d3f4fc49a5ca7dfc1b868f7286677c275ee201b06f65b": "그건 나도 동감이야. 하하.",
  "fc7db18868f826b24506279f03b252009e6543331acd1e5ca64be1cb016659c9": "다음은 도서관이야.",
  "e2bcc2eccec3f118f664e3c34e34280060347fb9f0ac7a5f46ba3e95e10ef88a": "여기 괴담이 생각나네.",
  "dc5b5bf122c7cc468d9bce3afe1d4159b479aba08bbc43bf2ad676bab28460b8": "책 빌리는 걸 좋아한다는 귀신?",
  "a0dd63f167cc051737884e77488dd01789bd468000ecaed38cf49c55c568fd6a": "아니.",
  "58e233b10fc979b32923b7f693fee6d93a9299cc0846dda2a6626ab6a5ad5d72": "다른 귀신 대신 글을 써 주는 귀신 말이야.",
  "59ddf5cd4694f44f6a2c61495844b2b6062e91e23821dcfe6c04d5c447c5dc91": "유령 작가... 아니, 대필 작가지.",
  "045d38455733540b99c75c517db64f624652598c01f1454a2744e8f4044397fa": "진짜 썰렁하다.",
  "ec0d91920942b65ec9d44b777435b87d5ab74aeac47f125e877d8dccc7cd9ce9": "헤헤.",
  "a47011a1f208b940946333797bf51e7d4a13f4a6cd5a5b4497eefd453f71e895": "매일 밤 여기서 우는 여자애가 있대.",
  "32d422a90c4955aca96d89f273bfcdaf064e9a31e1ebee609e9e1d435614b71c": "누군가 돌아오길 기다리는 것처럼.",
  "fa8b82d0126f585017a909954029992a8202d7bcba010db14e873c26655fb816": "그래서... 그 우는 여자애한테 무슨 일이 있었는데?",
  "9b47c34ccc0ae4f68b6f3d7883a8684e3f75791f09f7ce3e1bf37efcb0c075ca": "나도 몰라. 마음을 책처럼 덮어 두질 못했나 보지.",
  "fc301b92b3b49b4d5aaaf04d71d771a797ee04e62ed70c9b1163e904330876f2": "아, 그냥 괴담이겠지.",
  "69a5e46f85a97266c1eeba9944b74555ff95419900c5520a4afb176736a51b8d": "학생들이 지어낸 얘기일 거야.",
  "2387b34935831d9bdccda8e8367f72939c935e231f1e5c486afa69ce34a9e771": "그럴지도...",
  "45ac567ebb7cac5a2019bda1ac7f666aec3365f9490301b4385a464717e58a79": "하지만 정말 누군가를 기다리고 있다면...",
  "ca2d0eaf27d32305c7a9f651f5cf01a0908ce0e239012c39b5980a0d04c8df77": "그렇게 쉽게 두고 떠나진 않잖아. 그렇지?",
  "4dbe4fba7a5de3486c42502b439333427f4548cfc4d0b541b45dc7d5e5419f39": "헤헤... 가자...",
  "27eff759c3f2fa10ad4c452da83553146328355cba5b8d53e2fa9fe0630f2891": "재미있는 얘기 해 줄까?",
  "178c99f0ebf2af3d5c77a6f8b90cf964fd64a99395d93d4529e02b23decc07df": "농구공이 왜 둥근지 알아?",
  "653db0f0f0cbe09bdafd43be938ed6fc31283cd541ab8356477cec70f4ffc548": "왜?",
  "0f23264a0eff7765dd021a0fb5632c4a9fc86768220c8c969b5ea68bb247d522": "튀기면 다시 돌아오라고.",
  "2c564b668726db38af98f007a45809ed4c4d37c184d1135732f399d587b1b09e": "그럴듯하네.",
  "42c97ef7bdae8c4ae5a34a779d87b01ddc95fd8a7f481d946790acd531cd964d": "사람도 그러면 좋을 텐데.",
  "f85d30e7d95a052f65167f1f1095186d1190c91502b4ab7aedab460a6eab8870": "......",
  "0c7e001e9e812e328e0c3800602aa00b970c28460339ddac178b6212c36b0a61": "하지만 모두가... 돌아오는 건 아니지.",
  "a942d8b75429488670e9389764dbb82ad2bb79e8aa1f2335294d6ff60be8230f": "너 예전에 여기서 맨날 농구했잖아.",
  "5c39e39ec5c8d8feafa4e1e3ad3f6a2aafda15faf11927367c11c936e3a0a1e2": "널 보면 아직도 감탄하게 돼.",
  "78d52bfd0a63473bb13f441a7ef9f898cab81cd29d0f66645adfc7ad80c5a186": "아직 실력이 남아 있나 볼까.",
  "d3e6f91b29032952ef824fdbd14cdca22f18640cf90f80b4ef51a4b46efa14a2": "나이스 슛! 여전히 잘하네!",
  "62ccc24d23718c03caac006b0084b229085c9e3f5360a06cb322fdb3e2a1050e": "가자아, MVP!",
  "ac2274541e4b29340176b4d389dcd876aa5c13c2b04c7560037aa40fb8d01d91": "잘난 척 좀 하는데?!",
  "200b25636ffd865569b7a84728078948ab574a4004a632d101ef098c4477c950": "죽이는데에!",
  "b25e71bd319ad35987f5a759a9603fa69d7864a9b9949e829007cf9b888e49b5": "제이코오옵!!!",
  "872fbb2eb83fe4fd4e1a0251e2f690d214c50cd4886e8610cdb8d85161ae01c2": "별거 없네에에!",
  "18bb270a2eae15bb7c63bc4a61740b59c9162e98578c9526753e04b21f888359": "빵! 그리고 실패.",
  "8ab05f58a574a6e4161a00d1adaa24eaab86d939e9d62f0ca3b51993a3c94ee1": "뭐 하는 거야?",
  "5fe776c933748b5745016e6b9ee2fbfcd73fe62791d96b378c4d394d43e140f5": "슈터 맞아?!",
  "0a75092b64cac60b8ae9924eab89a2d340712ca4c651c592ab6558e3c6a0ca06": "땡! 바보오!",
  "0064975dd80b7a2750159ee8f4323438caa63d91666d89259e058046e72d7636": "와, 제이콥, 제법인데? 그런 숨은 재능이 있는 줄은 몰랐네.",
  "3d3ac921e51569146e0e6441752fa92001be734813f4856e1b7824b9c3dd6ee7": "계속 숨겨 두지 그랬어.",
  "9b90cac802e5f87565d0a16fa3d3e12eec114786699887ce06894383108c482f": "네가 질투할까 봐 숨겨 둔 거지.",
  "238c9c5bdfb07d1e92faf6300d4f08c26208e42f80cb3945a70b2cb7bd0af795": "야, 제이콥, 농담이야. 뭘 그렇게 진지하게 받아들여. 헤헤.",
  "0c72c0dfea928a0b74e72dd3a5af794053e503f930700ccdc829278874ad3311": "가자.",
  "fe773aa2505a716d6df87d7d96ee943abde42f700c2a6284069e8a206ea0be0b": "마지막으로 한 군데만 더 가면 돼.",
  "e94385eb85b2a83aa9fc61ca6ba00c1ee3f5c215612909312725315cba839981": "학생들이 여기서 훈련하곤 했어.",
  "1b3971adf47e3ec30e166da401352bbbebbf3ca97c2891745a6979158f742eca": "예전엔 널 여기서 자주 봤지.",
  "24fae24788eeba7f9d9fa2bdd84b27ec18a6f60d990a0018a123089c5b5781ca": "미안... 정말 아무것도 기억이 안 나.",
  "60b3a68115a28a4fc6c0d68d203fe644e8cbff80b19aab435c918b670680e71c": "그래도 고마워, 체사.",
  "467ac9cc48866fdbb38d408ddb6119a420ecbc4494fd1100fdf3d13c990643b0": "뭐가?",
  "8c176677cb7c8f8206bac0f0be21c1334e37509f560f7aac521d914b7c1cd8c5": "구경시켜 줘서.",
  "58edc71ce2f3b1baefcab56ca7cedc23041c1283e894a33e7ccd97d526440a2f": "뭘, 이 정도야.",
  "5b2a19cb19e8ef69c7023f211ba6f6463e0d731a46dd62b43be5c3860d8e2177": "정말 보고 싶었어, 제이콥.",
  "16b00a1eb3b7842c09c91e88d3583c44a43f3514d3cda0beec850fb5e110d189": "그냥 나랑 여기 있으면 안 돼? 헤헤.",
  "728000bf6ac72bc44cd9a6a63ce4110e4622f49087e49e71955b2565181778ad": "제이콥... 탁자 위의 물병 좀 가져다줄래?",
  "afac4882ebfd611c0cd8086fb9d37c0df9189ef55ead3caa7082a638e472a627": "고마워, 제이콥!",
  "bbe088fee9d0aa15ff7818029903255b7da3fb561f8adc3063f0d71d77766c41": "(뭐야, 대체...)",
  "ed3fc0accf730d6e3a8aa09d969bbf20a7885458f863dc6144860b8cdcce518f": "아... 깨어났네.",
  "c7e055a695603f2b666bfcbba6246749e004349e5303065a42025e99e0a4ea67": "괜찮아?",
  "1eae09288aa242263a69f16852c68d52e791359d20c11f3658941df00f77e4a5": "넌 영원히 나랑 함께 있을 거야...",
  "2568dd4db09f56c832accbbf82ed234b42a4422c6087ea90a4f2bd72a7393266": "안녕, 제이콥 :)",
