  "baaa67f710a2a8f02004fdace3fb1c27564507ad97e5a2fa193a3d7a760e16d3": "학교 곳곳의 회복 아이템을 찾아 체력을 회복하세요.",
  "64f908fd8dd3f3b20a38fcf7ea5599e71287606f3ea6238d05f536832018669c": "탈출구 찾기",
  "f92e4d42222a0070d16bc910de7f1cc293b158f339cf42688c550507eaaebbe1": "학교를 탐색하고 필요한 물건을 찾아 탈출구를 여세요. 행운을 빕니다... 즐거운 시간 보내세요!",
  "c544c0a408d6f6c525f9f18f735fc9326cf4cf4c892ac2475e2eed76973e08a6": "사망했습니다",
  "942087cc2d41e01304b7195558d093d10c72af8e838c7556d6a02d471ee71852": "다시 시도",
  "78b1a5f2cfda3e7cd6c0699ec370279b075e06a3f123fa1eb13cfd7526a68e1d": "E: 열기",
  "ff4cb85a95d66f7f8a2ca32588210f6fc023d54b4111413c880c1f3c578212be": "E: 줍기",
  "0b4d95735e5324808fca454034b33a06e304835901fda9a1d9acd4020cdc8971": "E: 상호작용",
  "1c4751e9bb0c234cd07bcc8b99a43795aea5b363ef18864c56bf4aeb4811fc2a": "E: 놓기",
  "a570570cc89f81b6db75923b09810950bdf94027b35c7e2713406f7523fb4431": "E: 먹기",
  "8efc15b1fc5ca11fac210cdc5a7d0a3ac7a753739f4a9af9c4d186e8afc7634b": "열쇠가 필요합니다",
  "0250f33964db7b709ab1de2c49da2f1c08995ea847d88b6133ecf1737f9a5781": "E: 달래기",
  "dfaed753cfcd789b4ea19982ec2562970da3da8f72f937d23641c1af5bb1fbdd": "E: 밀치기",
  "a424e33d90931d1ed22f2af37a3f3491a5c9de0dfae079f6f3ff4edf0309e07f": "잠김",
  "b19fb8d1b395b333251f40be2909ca37a0b0a007b3c4c4b34b726be71f715daa": "열림",
  "9d277cd87e603ed9cd2306553e4ef499c955f9675b892a900dcac24c0a43fba0": "(다른 곳부터 둘러보세요)",
  "fa2ffca64640cf02dab59d5c382646894c2fd6676d28190b6c75df14e5141dc2": "E 길게 누르기: 상호작용",
  "f6260d10c9b7eb6c8e070e01e8efde9f8caafaaa81c183ca4ab57ee6987d11f1": "보건실 열쇠가 필요합니다",
  "c6c270019cb331ef1f76e30dd5d3016efae2c5ffbe9142913bcc7cc344dc8fa4": "볼트 커터가 필요합니다",
  "ff2ef27e344ddbcb2309ce95605de9a732db3b171c99db02e51e1fd847aa5798": "쇠지렛대가 필요합니다",
  "a7dac4d4ba76c3a763b6717a289a40dd8da73d3169b339a87ad7129d9eeb1c46": "보라색 열쇠가 필요합니다",
  "2a8661b2f4805348933b1ea6d909de19008b2e649eaf7b7d5ed6071d052b68a5": "회색 열쇠가 필요합니다",
  "48b41b7f186d5ed827abfbc626882a510dfd2fea89d1dd57036865602bf47ef4": "구슬 6개가 필요합니다",
  "398e689c070bd6bcf267aa95b078fa2005796955caa7c3167cdca3c0a7d63cbd": "마우스를 움직여 양치하기",
  "07772fac6298726f2c867fce8c7456d29dc3ca6b2131cbc4c6f68b4fc3d52631": "'W' 길게 누르기: 이동",
  "5a42285ef1d544b915859d2ae84c4c71e687ac7be109abf6ba4a6b8d181c4f0f": "'W'에서 손 떼기: 뒤돌아보기",
  "c3d14fc1c514f4a8572a70da17bf29d7484201198ad1f7ff2d3fe493f015dcc8": "왼쪽 Shift: 달리기",
  "a3ef9b31d3568e063ed5f909cdca83dd5a9a8470e2b45183a041b20a6e02581b": "체사...",
  "8095bab8a01e14d9152ecf26fa0b02073c8d93c758af4aa913161010a7b0ba4d": "너한테 무슨 일이 있었던 거야?",
  "66d2cba1034dbcdaa4c39523981d165f10ba90fb0b6c55052034799f66a16c9c": "TV가 아직 켜져 있나?",
  "060d9824ae40f8b4c1acd440b16b223a37294713e2af7eef183e585cfdeffb09": "일단 꺼야겠어.",
  "13a30a2c8b6bac979ec42d531da72f5f97976ff368573fd0a98b165cd8c88895": "이 피규어들은",
  "8279fa47458f037e45e23a500d90c4fc6816e601e4284485bedab4671a1ffe2a": "디자인이 정말 멋져.",
  "1b48982fc6cae016609734a8c212d8314e514f1cb01b1ad2f60c3a1e9de2a6e0": "집이 좀 어질러졌네.",
  "f2911307d59df3d53d77a74d160f19c220c4a92889cb2bc529a0cb17b7cc0b9b": "청소해야겠어.",
  "3c6cf408a5259e7ac780d777ac703048f839c91d1a20f03362bbb3519f4ff702": "저 가방...",
  "5302383ba37de500077f93071daef115b687e215d0bd04a318fd3bfedc1dd300": "꿈에서 봤던 거랑 비슷한데.",
  "d238d097b52399b7f27532a43b74b8886eb498cc03a21cd1cc11a3daeb682006": "팔찌?",
  "3ef14ea610d768e29fc96b50de505b6e5de5aeba4549b9232748852dc28cf500": "아까 있던 다른 물건들은 어디 갔지?",
  "be7c1ae00e888cda81235029f6a96ea57022bc701304e97187cec1397fcf922e": "이게 무슨 뜻이지?",
  "725cb3ffe154f5e7ee5e0797cae037336f4d3be21f2795072324b163db250e8b": "왜 다른 물건들이 사라진 거야?",
  "9b63e8a1787cecfaa74a9f23afe38f7ec36f2ca6f21fb1d8818fb493fa326bf7": "아까 꾼 꿈이...",
  "d0fe21d1468610510534f5445647cdf837405123fbf5c85795a4006d42a6e3d0": "정말로 일어난 거야?!",
  "0f2f32e3a0f96dccfa7664977305ed6277089ca30f7ae81ace3552cc8167e18c": "순서 기억하기",
  "f847cead4c9f895ed0f170af770d8108d356740cac10998c12087ae03afffa40": "색과 소리의 순서를 잘 보고 기억하세요. 총 5라운드를 완료해야 합니다.",
  "f6549e41446494cc258aae42219c06a941adc1f087e11ae9714e61d5a382cdbb": "버튼 누르기",
  "8e4e7e281d18814cc76eb56526fec80f49398de1dd6c0da01c5b8fea7a261f0a": "1, 2, 3, 4 키로 버튼을 누르세요.",
  "1c0673af0fc83a2ba2123a483e0a01b1c716dd7c0768adb4558e67de675dc0bd": "순서 따라 하기",
  "fc17237fe3c1d7c118db19bd6d9e8e8956a7d51deb9ac3510234df12b74f54f9": "같은 순서로 버튼을 누르세요. 하지만 조심하세요... 버튼을 누를 때마다 체사가 당신을 잡으려 합니다!",
  "ef6a78d21807040a85b42f9c31af8602193990b3f30b00d5aeed38536e22d98c": "체사 물리치기!",
  "87d0ae6b1750e56022e9c3af12bd8c411b97a1c1304973189e5ad7647b63630f": "체사가 가까이 오면,",
  "175539b292c4307f247954953f679d1cc085dbe339708faf4236f8171e7f5071": "[S]를 눌러 뒤돌아본 뒤 손전등을 비춰 원래 자리로 돌려보내세요.",
  "d1f840c5cdfd8abbe7cde7c89d0b18a348b3dfd12a9f2f2e8588d494b00cb0ea": "다시 집중하기",
  "ee523005bff4655a8b80e46372e54346bf18df792deb93edaad7f85d08e66b36": "뒤를 보고 있을 때 [S]를 다시 누르면 순서 기억 게임으로 돌아갑니다.",
  "297549147b8384382ed3d292ec369fdc7db16db46ebba7f4eb0c8ddf9e06be38": "또 꿈을 꾸고 있어...",
  "caf051064bc56417688f41522aac590c6ed1727411f08037eff63263d708bdff": "보관한 물건:",
  "37aa083a6c9deb642f06d6e5e73a87eaa672b5d2fc540ef83d18aee40af631b4": "체사의 소중한 물건",
  "b4cc71fb45ee98c428ef271193c44d632ecc05b8ef94b7d468f80c931f0b73d0": "방 곳곳에 숨겨진 상자 3개를 찾으세요. 상자와 상호작용하면 미니게임이 시작됩니다!",
  "77ca1e16fa35ab41b04e202d59132a58c0d8acbd562d8cc6feb26b1528976ba0": "그렇게는 못 하지!",
  "9ac0df87bb10d0da5fc7f929c94bd67c15b6b39a98e8ba6b2315b9f03a4616d8": "타락한 체사는 당신을 발견하면 쫓아옵니다! 눈앞이나 무작위 위치로 순간이동할 수도 있으니 조심하세요!",
  "5273593f3ee776561098c1266bfd4938b68b93fc1dba79f8a97e0ca9df799d29": "빛을 싫어하는 체사",
  "c91c43e7a4041a8b84ae98a93b49cfc966867574bd8b3cec51e394b669b6d314": "타락한 체사는 빛을 싫어합니다! 바닥에 노란 원이 보이면 그 안에서 [E]를 눌러 5초 동안 불을 켜세요.",
  "0c31091160724308aaba7011c4eb7a67307b3758efe7d06f7abbf7334fae0ded": "꼭 찾아내길 바라!",
  "b2b340eb94d009e28315b408652d4095cdc83952cff38b9088c1394fb9cce01c": "상자 3개를 모두 찾아 미니게임을 완료하세요! 상자는 흰색 테두리로 빛나므로 쉽게 알아볼 수 있습니다. 즐겁게 도전하세요!",
  "2ceee6f3813460a2a4e1d79f7f3057d55ef7f06f066839d59c2e951b465b772b": "체육관에서 내 지갑을 찾아 줘서 고마워.",
  "19c827bf0665d7297d28920f43182fddb5b1db0767b530d2658ebc0999308df1": "이번 토요일에 옥상에서 만나서 돌려받기로 했잖아.",
  "81bdd8b8ad17d47630554dbe42f56b1219d8eeb8f8e0ba570a2d0c6f0d53eeb9": "답례로 지갑 안에 있던 50페소로 음료수도 사 주려고 했는데.",
  "fbde817e595df0c8ff19d0091636466638f3742d52658615f50e09b97747e85f": "알았지?",
  "d4e5f5248ce61f85ff661e57dc385ef97121775399bdf7a9af27aac9a1555ebf": "이걸 읽고 있다면, 맨날 가져간다고 하더니 결국 내 공책을 훔쳤구나.",
  "e6ce5bc4540f390eb5ee249d889e8a17f3b0777378bf3d17192580ba47661c88": "맞아, 온통 너를 그린 엉터리 낙서야. 그리고 맞아, 난 지난 몇 년 동안 바보같이 널 좋아했어. 이 바보야.",
  "7924efa4e2520b1944c2cbc029bc3f6897f244fe99c995642766209bc3698828": "우리가 여든 살이 될 때까진 들키면 안 됐는데.",
  "0f9cc1733252bb823b9a491bfc5e726e5c2b4751860696a2b524a62a91353d2a": "그 토요일 때문에 계획이 틀어졌네. 한순간에 모든 게 멈춰 버렸어.",
  "531cfd94f2634ecc1ab1131704a01b538d599403722ac14cc4038ee0c8e11455": "그렇다고 우쭐대진 마. 그리고 공책 잃어버리지 말고. 그건 내 마음이나 다름없으니까.",
  "4559867e4a9fedd1e1bf9ccf6363e3be4aedaffc885393a16455cd332983d691": "내가 제일 아끼는 연필, 아직 네가 갖고 있지? 중학교 때 음악·미술·체육·보건 과목에서 같이 낙제했을 때 지우개를 씹어 놓은 그 연필.",
  "c3c8ad6ef98a5cc2e1a6a180a8503fe80dbec11a6166d1838cfd2899e6434e4d": "금요일에 돌려준다고 해 놓고, 넌 늘 그렇듯 잊어버렸지.",
  "e3425854525c3b6f316379a7064775cd8013a1f280edd0afdd0683db2f223e0c": "이제 하루에 5페소씩 이자를 받을 거야. 그렇게 알아 둬.",
  "90e2d7efed71a2e0723a2a12a770d140c95416c1ae9b51a087ef4e4d4d60a21b": "오늘 직접 만나서 한소리하려고 했는데... 뭐, 토요일이 그렇게 됐네. 모든 게 순식간에 조용해졌어.",
  "7e61077a001e9b83ea8e52fb56b7a61c57b4418aed20a0dde3718c32d28495a1": "연필은 당분간 네가 갖고 있어. 대신 다음에 만나면 제대로 갚아야 해. 알았지? 잃어버리지 마.",
  "fc623e9082b18910da0cef86c148d70e86016a9a7c6d767c994149000ed309e3": "-체사",
  "57ffe98fd5bf35525609ffd214e308278a96df5366cb34942a9ad786c48191b4": "[Left Click]: 그리기",
  "f20e352e63f7850a4218bb568afa327cd54c76ea8622998c6fd67ed14612022b": "마지막으로 그린 선 끝에서 이어 그리세요",
  "93e9d30fd4054dfff65ca69182f88579c51b5b7a5b3d11277739813dce1a1653": "[1], [2], [3]: 바깥 확인",
  "a29df165e9c788899550cad9cc6a0545c114963bc9bf51aad7faebf72d2dd4c1": "[S]: 다시 그리기",
  "3c2fb82d31a2d66e1bb3053db3cf223b4f58afc5807518cedd9a59446ce429d7": "따라 그리기 실패",
  "66dd79ef6f2c54a4288363d6bf7147f862c2aa070d022875cb473d60c571f464": "[R]: 초기화",
  "ad7885f8f43d2a3e78d9473cf5a28aa12fcb306fe4bdb4016bf930df1e3ed9ac": "[R]: 선을 지우고 다시 시작",
  "cad8ae6b4f0a8be93a36aeeff616a2eeacefe057651febad6fea3497e95611cb": "도움말: 선이 그려지지 않거나 정확도가 떨어지면 다시 시작하세요",
  "09557d05f4e36a7aff1c7133cbdd3a4bedcd94d9bd2c888aac138aa321888893": "선 그리기",
  "36e8b1bb099bcce05e12a8269de71d2ee88a1cf16b23483d6469572396c37a41": "[Left Click]을 누른 채 선을 그리세요.",
  "d568e754cdc68130a58ae9d51d53f94fae415f1b9934dbfb59e8378e7919956c": "그리기를 멈췄다면 마지막으로 그린 지점에서 이어 그려야 합니다.",
  "4ef74142f8839c2f2dd7c50654d256afa5164457e4fe872ceb60efbd85388a2e": "모양 따라 그리기!",
  "5858fac67aec2f0eab8742d56fce11985e72bd5ec3f764b28ba6a7976e508bdf": "모양을 정확히 따라 그리세요. 총 3라운드입니다!",
  "6e75ca8a6c4fd13557c76f8b0eb8dcd8ba1d67be38463260fca34d02753accde": "문제가 생기면 초기화하기",
  "d6605ec49416747f6ea1fe033df2b5e6dbca938c68cb6dee204702bf25a96297": "[R]을 누르면 선을 지우고 처음부터 다시 시작합니다.",
  "a47f70e6a557e4b8d3e23356a39d2afa50007bfb21b1f10706f317624d93e98b": "실패했거나 정확도가 떨어질 때, 또는 막혔을 때 사용하세요.",
  "b9f227f3998f52d525db9b510d28a210c3ddce95055b219ef96237a3d8a2ba7a": "그만 그려! 잡으러 간다!",
  "4e268d6458d5f0597e617535ff3ff87ebcfc7e8b698cb90484bdd89e8d71984e": "체사가 방으로 들어오려 합니다! 지직거리는 소리가 들리면 대개 창문 근처에 있다는 뜻입니다.",
  "47383147cb55653759004dff32ddbd95ea7ea757fb7cbc1279675d4f2a3e8234": "[2]나 [3]으로 창문을 확인한 뒤 손전등을 비춰 체사를 쫓아내세요.",
  "80e9c5b654e1875a61df1a76b7fef4793bae0b5bf977e7d06008757bf03b2363": "체사가 온다!",
  "6e8e8d68ec7b49fa56d32f0c076fc540bb41a34d114db031a6ba2bb72163de00": "체사가 문까지 오면 문이 빛을 가리기 때문에 손전등으로 막을 수 없습니다.",
  "67e24664201bde0e70a5b6f72f9e7f8cc9e313dd7b60445f08d7b8fd83443713": "체사를 쫓아내려면 지금 그리는 그림을 완성하거나, 시간이 다 되기 전에 체사를 원래 자리로 돌려보내야 합니다.",
  "1e12f1ca23b542906e07cfa40d5fc36760cf14bd2cab86f2288763d6f6e78006": "[1]로 문을 확인할 수는 있지만, 체사를 막을 수는 없습니다.",
  "39495bf1d1bd73ce1c73b4f6c241b86779014323940a7996b5436e45f30d2f6c": "그림으로 돌아가기",
  "5c48f68760f23ab7430cba937408b8200708dc6835ddbe677b42db3b721f4c55": "[S]를 누르면 그림 화면으로 돌아갑니다.",
  "18b40a8186adadd2a24ed0b07c824d8f639a8f07eaaa4181609d20488bdf3e0c": "겁먹지 마세요!",
